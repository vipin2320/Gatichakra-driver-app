{
  "entities": {
    "Driver": {
      "title": "Driver",
      "description": "Driver profile and approval details",
      "type": "object",
      "properties": {
        "driverId": { "type": "string" },
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "phone": { "type": "string", "minLength": 5, "maxLength": 20 },
        "profilePhotoUrl": { "type": "string", "maxLength": 1000 },
        "vehicleType": { "type": "string", "maxLength": 50 },
        "vehicleNumber": { "type": "string", "maxLength": 30 },
        "vehicleModel": { "type": "string", "maxLength": 50 },
        "vehicleColor": { "type": "string", "maxLength": 30 },
        "manufacturingYear": { "type": "string", "maxLength": 10 },
        "isApproved": { "type": "boolean" },
        "approvalStatus": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "approvalReason": { "type": "string", "maxLength": 500 },
        "isOnline": { "type": "boolean" },
        "isAvailable": { "type": "boolean" },
        "rating": { "type": "number" },
        "totalTrips": { "type": "number" }
      },
      "required": ["driverId", "name", "phone", "isApproved", "approvalStatus", "isOnline", "isAvailable"]
    },
    "DriverDocuments": {
      "title": "DriverDocuments",
      "description": "Driver uploaded verification document references",
      "type": "object",
      "properties": {
        "driverId": { "type": "string" },
        "profilePhotoUrl": { "type": "string", "maxLength": 1000 },
        "drivingLicenseUrl": { "type": "string", "maxLength": 1000 },
        "vehicleRcUrl": { "type": "string", "maxLength": 1000 },
        "additionalDocumentUrl": { "type": "string", "maxLength": 1000 },
        "verificationStatus": { "type": "string", "enum": ["pending", "approved", "rejected"] }
      },
      "required": ["driverId", "verificationStatus"]
    },
    "DriverLocation": {
      "title": "DriverLocation",
      "description": "Realtime location coordinates of active drivers",
      "type": "object",
      "properties": {
        "driverId": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "heading": { "type": "number" },
        "accuracy": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["driverId", "latitude", "longitude"]
    },
    "DriverStats": {
      "title": "DriverStats",
      "description": "Daily and total operational statistics for drivers",
      "type": "object",
      "properties": {
        "driverId": { "type": "string" },
        "todayTrips": { "type": "number" },
        "todayEarnings": { "type": "number" },
        "rating": { "type": "number" },
        "totalTrips": { "type": "number" }
      },
      "required": ["driverId"]
    },
    "AdminNotification": {
      "title": "AdminNotification",
      "description": "Notifications or messages sent from driver app to admin regarding account verification or missing details",
      "type": "object",
      "properties": {
        "notificationId": { "type": "string" },
        "driverId": { "type": "string" },
        "driverName": { "type": "string" },
        "driverPhone": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["driverId", "message"]
    },
    "Ride": {
      "title": "Ride",
      "description": "Shared trip requests and assigned rides between drivers and customers",
      "type": "object",
      "properties": {
        "rideId": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "pickupAddress": { "type": "string" },
        "pickupLatitude": { "type": "number" },
        "pickupLongitude": { "type": "number" },
        "destinationAddress": { "type": "string" },
        "destinationLatitude": { "type": "number" },
        "destinationLongitude": { "type": "number" },
        "vehicleType": { "type": "string" },
        "distanceKm": { "type": "number" },
        "estimatedDurationMinutes": { "type": "number" },
        "baseFare": { "type": "number" },
        "distanceCharge": { "type": "number" },
        "waitingCharge": { "type": "number" },
        "estimatedFare": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "rideStatus": { "type": "string", "enum": ["searching", "driverAssigned", "driverArriving", "driverArrived", "rideStarted", "rideCompleted", "cancelledByCustomer", "cancelledByDriver"] },
        "driverId": { "type": "string" },
        "driverName": { "type": "string" },
        "driverPhone": { "type": "string" },
        "driverVehicleType": { "type": "string" },
        "driverVehicleNumber": { "type": "string" },
        "driverLatitude": { "type": "number" },
        "driverLongitude": { "type": "number" },
        "createdAt": { "type": "string" },
        "acceptedAt": { "type": "string" },
        "startedAt": { "type": "string" },
        "completedAt": { "type": "string" },
        "cancelledAt": { "type": "string" }
      },
      "required": ["rideId", "customerId", "pickupAddress", "destinationAddress", "vehicleType", "estimatedFare", "rideStatus"]
    }
  },
  "firestore": {
    "/drivers/{driverId}": {
      "schema": { "$ref": "#/entities/Driver" },
      "description": "Stores individual driver profiles"
    },
    "/driverDocuments/{driverId}": {
      "schema": { "$ref": "#/entities/DriverDocuments" },
      "description": "Stores driver document metadata and verification status"
    },
    "/driverLocations/{driverId}": {
      "schema": { "$ref": "#/entities/DriverLocation" },
      "description": "Stores real-time driver locations"
    },
    "/driverStats/{driverId}": {
      "schema": { "$ref": "#/entities/DriverStats" },
      "description": "Stores driver earnings and trip statistics"
    },
    "/adminNotifications/{notificationId}": {
      "schema": { "$ref": "#/entities/AdminNotification" },
      "description": "Stores notification messages sent to admins regarding verification issues or missing details"
    },
    "/rides/{rideId}": {
      "schema": { "$ref": "#/entities/Ride" },
      "description": "Stores active and historical ride requests"
    }
  }
}
